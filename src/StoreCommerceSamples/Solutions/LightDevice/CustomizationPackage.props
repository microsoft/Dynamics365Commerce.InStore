<Project>
  <Import Project="..\..\..\..\repo.props" />

  <PropertyGroup>
    <PackagePublisher Condition="'$(PackagePublisher)' == ''">$(Publisher)</PackagePublisher>
    <PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)' == ''">$(PublisherDisplayName)</PackagePublisherDisplayName>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <PackageName Condition="'$(PackageName)' == ''">Contoso.LightDevice</PackageName>
    <PackageDisplayName Condition="'$(PackageDisplayName)' == ''">Light Device Sample</PackageDisplayName>
    <PackageDescription Condition="'$(PackageDescription)' == ''">A sample showcasing a solution to control a light device via OPOS.</PackageDescription>
  </PropertyGroup>
</Project>
