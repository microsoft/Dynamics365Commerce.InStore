<Project>
  <Import Project="..\..\repo.props" />

  <PropertyGroup>
    <PackagePublisher Condition="'$(PackagePublisher)' == ''">$(Publisher)</PackagePublisher>
    <PackagePublisherDisplayName Condition="'$(PackagePublisherDisplayName)' == ''">$(PublisherDisplayName)</PackagePublisherDisplayName>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <PackageName Condition="'$(PackageName)' == ''">Contoso.MyMobileAppExtensions</PackageName>
    <PackageDisplayName Condition="'$(PackageDisplayName)' == ''">My Store Commerce Mobile App Extensions</PackageDisplayName>
    <PackageDescription Condition="'$(PackageDescription)' == ''">My Store Commerce Mobile App Extensions Packaging Sample</PackageDescription>
    <GenerateSQLiteDb Condition="'$(GenerateSQLiteDb)' == ''">true</GenerateSQLiteDb>
  </PropertyGroup>
</Project>