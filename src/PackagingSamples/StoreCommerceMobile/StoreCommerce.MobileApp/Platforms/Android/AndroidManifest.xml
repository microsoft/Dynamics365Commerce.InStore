        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="ms-appx-web" android:host="microsoft.aad.brokerplugin" android:path="/d6b5a0bd-bf3f-4a8c-b370-619fb3d0e1cc" />
      </intent-filter>
    </activity>
  </application>
  <queries>
    <intent>
      <action android:name="android.support.customtabs.action.CustomTabsService" />
    </intent>
  </queries>
</manifest>